# Copy to .env and fill in. .env is git-ignored; values already set in the
# environment take precedence over this file.

# Auth for the Claude Agent SDK. Run `claude setup-token` to get one.
CLAUDE_CODE_OAUTH_TOKEN=

# Answer backend
KB_ANSWER_MODEL=claude-sonnet-4-6
KB_ANSWER_HOST=127.0.0.1
KB_ANSWER_PORT=8781
KB_ANSWER_MAX_TURNS=20
KB_MCP_URL=http://127.0.0.1:8766/mcp
# Answer language: en | zh (the UI can override per request)
KB_LANG=en

# Retrieval. The cross-encoder reranker is off by default; see README "Production notes".
KB_USE_RERANK=0
KB_RERANK_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANK_TOPN=12

# Optional: where the built knowledge bases live (defaults to ./kbs)
# EU4_KBS_DIR=
